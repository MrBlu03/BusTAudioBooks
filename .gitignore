node_modules/
npm-debug.log*
*.log
.DS_Store
Thumbs.db

# Environment variables & secrets (keep .env.example tracked)
.env
.env.*
.env*.local
!.env.example

# Jackett runtime state — mounted into the container at /config.
# ServerConfig.json holds a live API key, DataProtection/ holds signing keys,
# Indexers/ holds per-indexer credentials, log.txt is a 200KB rolling log.
# None of this belongs in version control.
selfhost/jackett-config/

# Nuvio OAuth tokens (access + rotating refresh). Written by src/nuvio.js.
.nuvio-auth.json
*.auth.json

# Generated recommendations cache. Rebuildable; do not commit.
.recs.json
.recs-state.json

# Editor & IDE configs
.vscode/
.idea/
