# Port the addon listens on (default 7000)
PORT=7000

# --- Shared-instance search (so friends only need their TorBox key) ---
# Set these to YOUR Jackett so every user of this instance gets search without
# configuring anything. When set, the configure page hides the source fields.
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=

# Alternatively (or additionally) provide a default AudiobookBay domain for the
# built-in scraper. Also makes the configure page hide the source fields.
ABB_DOMAIN=

# Force instant-only mode for every install served by this instance (1 = on).
INSTANT_ONLY=

# Torznab categories used for the mobile app's Comics search (default 7030 =
# Books/Comics). Override if your indexers file manga/comics elsewhere,
# e.g. COMIC_CATEGORIES=7030,8000
COMIC_CATEGORIES=

# Access gate: comma-separated tokens users must include (via the configure page)
# to use this instance. Give each friend their own so you can revoke individually.
# Leave blank to keep the instance open.
ACCESS_TOKENS=

# Native app update prompt: when you publish a new APK, set these so the app can
# show users a "new version available" banner. (JS/UI updates go out via EAS
# Update OTA and don't need these.)
APP_LATEST_VERSION=
APP_APK_URL=
APP_MIN_VERSION=

# --- Nuvio (personal recommendations) -----------------------------------------
# Optional. When set, `npm run recs:refresh` reads this account's library and
# generates a "Recommended For You" catalogue from it. Leave blank to disable.
#
# NUVIO_EMAIL / NUVIO_PASSWORD are only used to exchange for an access token;
# a pasted access_token would not work because they expire after one hour. The
# rotating refresh token is cached in .nuvio-auth.json (gitignored).
#
# NUVIO_PROFILE_ID is the profile index 1..6. Run `npm run recs:profiles` to
# list them.
NUVIO_EMAIL=
NUVIO_PASSWORD=
NUVIO_PROFILE_ID=

# Set to 0 to skip the Libex title/author cleanup pass over library names.
# RECS_CANONICALISE=0

# Model used to generate recommendations. Must be a free model.
#   opencode/space-bunny-free            (default; clean titles, ~30s)
#   opencode/mimo-v2.6-flash-free        (also clean, slower, ~50s)
#   opencode/nemotron-3.5-lightning-free
#   opencode/longcat-2.5-preview-free
# Avoid opencode/ling-3.0-flash-fin-free: it does not return parseable JSON.
# RECS_MODEL=opencode/space-bunny-free

# How many titles to ask for, and the polite gap between the searches that
# resolve them. The gap matters: AudiobookBay answers a burst with an empty
# page, so keep it at least ~2000ms.
# RECS_COUNT=15
# RECS_GAP_MS=2500
